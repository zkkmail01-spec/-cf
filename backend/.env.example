# Local development defaults. Never commit a real database password.
APP_ENV=local
DATABASE_URL=sqlite+aiosqlite:///./family_menu.db
ALLOW_MOCK_IDENTITY=false
API_PREFIX=/api/v1

# CloudBase 文档数据库（云托管生产环境）
# STORAGE_BACKEND=cloudbase
# CLOUDBASE_ENV_ID=zkk-20261010-d6gfxxdhfe3f8fc75
# CLOUDBASE_REGION=ap-shanghai
# TENCENTCLOUD_SECRETID=由云托管密钥注入
# TENCENTCLOUD_SECRETKEY=由云托管密钥注入

# Cloud Hosting example:
# APP_ENV=production
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
