.image-box { display: flex; align-items: center; justify-content: center; width: 100%; height: 340rpx; margin-bottom: 34rpx; border-radius: 28rpx; background: #e9e3d6; color: #737a75; text-align: center; }
.image-box image { width: 100%; height: 100%; border-radius: 28rpx; }
.image-icon { margin-bottom: 12rpx; font-size: 64rpx; }
.label { margin-top: 28rpx; font-weight: 650; }
.textarea { min-height: 180rpx; }
.ingredient-heading { display: flex; align-items: center; justify-content: space-between; }
.ingredient-heading button { margin: 22rpx 0 0; background: transparent; color: #2f684a; font-size: 26rpx; }
.ingredient-card { margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: #fffdf8; }
.ingredient-card input { margin-bottom: 14rpx; padding: 18rpx; border-radius: 14rpx; background: #f4f0e7; }
.quantity-row { display: flex; gap: 14rpx; }.quantity-row input { flex: 1; }
.remove { background: transparent; color: #b54b3f; font-size: 24rpx; }
.danger-button { min-height: 88rpx; margin-top: 20rpx; border: 2rpx solid #b54b3f; border-radius: 22rpx; background: transparent; color: #b54b3f; }
