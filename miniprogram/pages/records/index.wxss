.month-header { display: flex; align-items: center; justify-content: space-between; }.month-header button { margin: 0; background: transparent; color: #2f684a; font-size: 48rpx; }.month-title { font-size: 36rpx; font-weight: 700; }
.weekday-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); }.weekday-row { margin-top: 24rpx; color: #7a817d; text-align: center; }
.calendar-day { position: relative; display: flex; align-items: center; justify-content: center; height: 82rpx; margin: 5rpx; border-radius: 18rpx; background: #fffdf8; }.calendar-day.empty { background: transparent; }.calendar-day.selected { background: #2f684a; color: #fff; }.meal-dot { position: absolute; bottom: 9rpx; width: 9rpx; height: 9rpx; border-radius: 50%; background: #f4a259; }
.day-title { margin: 40rpx 0 20rpx; font-size: 34rpx; font-weight: 700; }.meal-section { margin-bottom: 20rpx; padding: 26rpx; }.meal-heading { display: flex; align-items: center; justify-content: space-between; font-weight: 700; }.meal-heading button { margin: 0; background: transparent; color: #2f684a; font-size: 24rpx; }.history-dish { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 2rpx solid #eee8dc; }.subtle { color: #7c837e; font-size: 24rpx; }
.dialog-mask { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(24,36,29,.46); }.dialog { box-sizing: border-box; width: 100%; border-radius: 32rpx 32rpx 0 0; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }.dialog-title { font-size: 36rpx; font-weight: 700; }.target-meals { display: flex; gap: 14rpx; margin-top: 20rpx; }.target-pill { flex: 1; padding: 18rpx; border-radius: 16rpx; background: #ebe5d9; text-align: center; }.target-pill.active { background: #2f684a; color: #fff; }.cancel-button { margin-top: 12rpx; background: transparent; color: #707873; }
