.toolbar { display: flex; align-items: center; justify-content: space-between; }
.add-button { margin: 0; min-height: 72rpx; padding: 0 24rpx; border-radius: 18rpx; background: #f4a259; color: #fff; font-size: 26rpx; line-height: 72rpx; }
.category-row { margin: 22rpx 0; white-space: nowrap; }
.category-pill { display: inline-block; margin-right: 14rpx; padding: 15rpx 24rpx; border-radius: 99rpx; background: #ebe5d9; }
.category-pill.active { background: #2f684a; color: #fff; }
.category-create { display: flex; margin-bottom: 24rpx; }
.category-input { flex: 1; padding: 18rpx; border-radius: 16rpx; background: #fff; }
.category-create button { margin: 0 0 0 12rpx; background: #2f684a; color: #fff; font-size: 24rpx; }
