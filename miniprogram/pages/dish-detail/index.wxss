.dish-image { display: flex; align-items: center; justify-content: center; width: 100%; height: 360rpx; border-radius: 28rpx; background: #e9e3d6; }
.placeholder { color: #737a75; font-size: 80rpx; }
.summary-card { margin-top: 24rpx; }
.category { display: inline-flex; padding: 8rpx 18rpx; border-radius: 999rpx; background: #e4efe7; color: #2f684a; font-size: 24rpx; }
.title { margin-top: 18rpx; }
.description { margin-top: 18rpx; color: #606c65; line-height: 1.7; white-space: pre-wrap; }
.section-title { margin: 38rpx 4rpx 18rpx; font-size: 34rpx; font-weight: 700; }
.ingredient-list { overflow: hidden; border-radius: 24rpx; background: #fffdf8; }
.ingredient-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 26rpx 28rpx; border-bottom: 2rpx solid #eee8dc; }
.ingredient-row:last-child { border-bottom: 0; }
.ingredient-name { font-weight: 600; }
.ingredient-note { margin-top: 8rpx; color: #7a837e; font-size: 24rpx; }
.ingredient-amount { flex-shrink: 0; color: #2f684a; font-weight: 600; }
.empty-ingredients { padding: 56rpx 24rpx; border-radius: 24rpx; background: #fffdf8; color: #7a837e; text-align: center; }
