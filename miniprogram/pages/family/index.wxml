<view class="page family-page"><empty-state wx:if="{{loading || error}}" loading="{{loading}}" error="{{error}}" action-text="重试" bindaction="loadFamily" /><view wx:else><view class="family-hero card"><view class="family-avatar">🏡</view><view><view class="title">{{family.name}}</view><view class="subtitle">{{member.role === 'chef' ? '你是厨师长' : '你是家庭成员'}}</view></view></view><view wx:if="{{permissions.canInvite}}" class="invite-card card"><view><view class="section-title">邀请家人</view><view class="subtitle">邀请有效 72 小时，可供 10 人加入。</view></view><button wx:if="{{!shareData}}" loading="{{inviting}}" bindtap="createInvitation">生成邀请</button><button wx:else open-type="share">发给家人</button></view><view class="section-title">家庭成员</view><view wx:for="{{members}}" wx:key="id" class="member-row"><view class="member-avatar">{{item.initial}}</view><view class="member-info"><view>{{item.nickname}}</view><view class="role">{{item.role === 'chef' ? '厨师长' : '成员'}}</view></view><button wx:if="{{permissions.canRemoveMembers && item.id !== member.id}}" data-member="{{item}}" bindtap="removeMember">移除</button></view><button class="danger-button" bindtap="leaveFamily">退出家庭</button></view></view>
