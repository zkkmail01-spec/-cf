.range-card { display: flex; align-items: center; justify-content: space-around; margin: 32rpx 0; padding: 26rpx; color: #2f684a; font-weight: 650; }.saving { margin-bottom: 16rpx; color: #7d847f; text-align: center; }.shopping-item { display: flex; align-items: center; min-height: 96rpx; margin-bottom: 16rpx; padding: 0 24rpx; border-radius: 20rpx; background: #fffdf8; }.shopping-item.checked { opacity: .58; }.check { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin-right: 20rpx; border: 3rpx solid #2f684a; border-radius: 12rpx; color: #2f684a; }.item-name { flex: 1; font-weight: 600; }.quantity { color: #737b76; }.shopping-item.checked .item-name { text-decoration: line-through; }
