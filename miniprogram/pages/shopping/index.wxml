<view class="page shopping-page"><view class="title">采购食材</view><view class="subtitle">按菜单自动汇总，同名同单位合并。</view><view class="range-card card"><picker mode="date" value="{{start}}" bindchange="onStart"><view>{{start}}</view></picker><text>至</text><picker mode="date" value="{{end}}" bindchange="onEnd"><view>{{end}}</view></picker></view><view wx:if="{{saving}}" class="saving">正在保存勾选…</view><empty-state wx:if="{{loading || error || !items.length}}" loading="{{loading}}" error="{{error}}" title="这段时间还没有需要采购的食材" action-text="重试" bindaction="loadShopping" /><view wx:for="{{items}}" wx:key="key" data-key="{{item.key}}" class="shopping-item {{item.checked ? 'checked' : ''}}" bindtap="toggleItem"><view class="check">{{item.checked ? '✓' : ''}}</view><view class="item-name">{{item.name}}</view><view class="quantity">{{item.quantity}} {{item.unit}}</view></view></view>
